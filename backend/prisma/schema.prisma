generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth & Access Control
// ============================================

model User {
  id                 Int      @id @default(autoincrement())
  name               String
  username           String   @unique
  password           String
  roleId             Int      @map("role_id")
  isActive           Boolean  @default(true) @map("is_active")
  hasSensitiveAccess Boolean  @default(false) @map("has_sensitive_access")
  branchId           Int?     @map("branch_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  role                        Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch                      Branch?                  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  accessibleBranches          Branch[]                 @relation("AccessibleBranches")
  sales                       Sale[]                   @relation("SaleCreator")
  appliedDiscounts            Sale[]                   @relation("SaleDiscountApplier")
  auditLogs                   AuditLog[]
  stockTransfers              StockTransfer[]
  acceptedStockTransfers      StockTransfer[]          @relation("StockTransferAcceptedBy")
  createdTransfers            CashTransfer[]           @relation("TransferCreator")
  acceptedTransfers           CashTransfer[]           @relation("TransferAccepter")
  createdTransactions         EmployeeTransaction[]    @relation("TransactionCreator")
  createdPayrolls             Payroll[]                @relation("PayrollCreator")
  shifts                      Shift[]
  reviewedShifts              Shift[]                  @relation("ShiftReviewer")
  deposits                    Deposit[]                @relation("DepositCreator")
  withdrawals                 Withdrawal[]             @relation("WithdrawalCreator")
  createdDeliveryTransactions DeliveryManTransaction[]
  createdProductionOrders     ProductionOrder[]        @relation("ProductionOrderCreator")
  cancelledProductionOrders   ProductionOrder[]        @relation("ProductionOrderCanceller")
  initialInventoryEntries     InitialInventory[]
  createdOrders               Order[]                  @relation("OrderCreatedBy")
  claimedOrders               Order[]                  @relation("OrderClaimedBy")
  cancelledOrders             Order[]                  @relation("OrderCancelledBy")
  notifications               Notification[]

  // Bulk POS back-relations
  createdBulkCustomers      BulkCustomer[]      @relation("BulkCustomerCreator")
  createdBulkContractPrices BulkContractPrice[] @relation("BulkContractPriceCreator")
  createdBulkOrders         BulkOrder[]         @relation("BulkOrderCreator")
  cancelledBulkOrders       BulkOrder[]         @relation("BulkOrderCanceller")
  createdBulkPayments       BulkPayment[]       @relation("BulkPaymentCreator")
  voidedBulkPayments        BulkPayment[]       @relation("BulkPaymentVoider")
  createdBulkRefunds        BulkRefund[]        @relation("BulkRefundCreator")

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  permissions Permission[]

  @@map("roles")
}

enum Module {
  // Module Access Permissions
  HR
  INVENTORY
  INVENTORY_COUNT
  STOCK_TRANSFER
  POS
  PURCHASES
  SALES
  REPORTS
  TREASURIES
  CASH_TRANSFER
  TRANSFER_MANAGEMENT
  WAREHOUSE_TRANSFER_MANAGEMENT
  BRANCHES
  EMPLOYEES
  CLIENTS
  SUPPLIERS
  SUPPLIER_ACCOUNTS
  CATEGORIES
  ITEMS
  WAREHOUSES
  SETTINGS
  EXPENSES
  SHIFTS
  DELIVERY_SETTLEMENT

  // Creation Permissions (CREATES)
  CREATES_WAREHOUSES
  CREATES_EMPLOYEES
  CREATES_SUPPLIERS
  CREATES_CLIENTS
  CREATES_CATEGORIES
  CREATES_ITEMS
  CREATES_TREASURIES
  CREATES_BRANCHES

  DEPOSITS
  CREATES_DEPOSITS
  WITHDRAWALS
  CREATES_WITHDRAWALS
  DELIVERY_MEN
  CREATES_DELIVERY_MEN
  DELIVERY_ZONES
  CREATES_DELIVERY_ZONES
  CREATES_PRODUCTION
  PRODUCTION

  INITIAL_INVENTORY
  CALL_CENTER

  // Bulk POS (B2B wholesale) module permissions
  BULK_POS
  BULK_CUSTOMERS
  BULK_PRICING
  BULK_CREDIT
  BULK_REPORTS

  // Return authorization (manager-level; NOT implied by POS/SALES/PURCHASES)
  SALES_RETURNS
  PURCHASE_RETURNS
}

model Permission {
  id        Int     @id @default(autoincrement())
  roleId    Int     @map("role_id")
  module    Module
  canAccess Boolean @default(false) @map("can_access")

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("permissions")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  action       String   @db.VarChar(20)
  targetEntity String   @map("target_entity") @db.VarChar(60)
  targetId     String?  @map("target_id") @db.VarChar(40)
  details      Json?
  oldValues    Json?    @map("old_values")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  branchId     Int?     @map("branch_id")
  rowHash      String?  @map("row_hash") @db.Char(64)
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([targetEntity, targetId])
  @@index([branchId, createdAt])
  @@map("audit_logs")
}

// ============================================
// Employee Management
// ============================================

model Employee {
  id                  Int      @id @default(autoincrement())
  name                String
  position            String
  branchId            Int      @map("branch_id")
  phoneNumber         String   @map("phone_number")
  nationalId          String?  @map("national_id")
  workingDaysPerMonth Int      @default(26) @map("working_days_per_month")
  workingHoursPerDay  Decimal  @default(8) @map("working_hours_per_day") @db.Decimal(4, 2)
  weeklyHoliday       String   @default("Friday") @map("weekly_holiday")
  salary              Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  branch       Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales        Sale[]
  transactions EmployeeTransaction[]
  payrolls     Payroll[]

  @@map("employees")
}

model EmployeeTransaction {
  id          Int             @id @default(autoincrement())
  employeeId  Int             @map("employee_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  reason      String?         @db.Text
  date        DateTime        @default(now())
  createdById Int?            @map("created_by_id")
  branchId    Int?            @map("branch_id")
  shiftId     Int?            @map("shift_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("TransactionCreator", fields: [createdById], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shift     Shift?   @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@map("employee_transactions")
}

enum TransactionType {
  ADVANCE
  DEDUCTION
}

model Payroll {
  id          Int           @id @default(autoincrement())
  employeeId  Int           @map("employee_id")
  month       Int
  year        Int
  baseSalary  Decimal       @map("base_salary") @db.Decimal(10, 2)
  advances    Decimal       @default(0) @db.Decimal(10, 2)
  deductions  Decimal       @default(0) @db.Decimal(10, 2)
  netSalary   Decimal       @map("net_salary") @db.Decimal(10, 2)
  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?     @map("payment_date")
  createdById Int?          @map("created_by_id")
  treasuryId  Int?          @map("treasury_id")
  shiftId     Int?          @map("shift_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?     @relation("PayrollCreator", fields: [createdById], references: [id])
  treasury  Treasury? @relation(fields: [treasuryId], references: [id], onDelete: SetNull)
  shift     Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([employeeId, month, year])
  @@map("payrolls")
}

enum PayrollStatus {
  PENDING
  PAID
}

// ============================================
// Warehouse Management
// ============================================

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  // Relations
  branch                 Branch?
  purchases              Purchase[]
  sales                  Sale[]
  inventory              Inventory[]
  outgoingStockTransfers StockTransfer[]   @relation("StockTransferFrom")
  incomingStockTransfers StockTransfer[]   @relation("StockTransferTo")
  sourceProductionOrders ProductionOrder[] @relation("SourceWarehouse")
  destProductionOrders   ProductionOrder[] @relation("DestWarehouse")

  // Config Relations
  systemConfigAsMain      SystemConfiguration[]
  initialInventoryEntries InitialInventory[]
  bulkOrders              BulkOrder[]

  @@map("warehouses")
}

// ============================================
// Treasury Management
// ============================================

model Treasury {
  id        Int           @id @default(autoincrement())
  name      String
  balance   Decimal       @default(0) @db.Decimal(10, 2)
  scope     TreasuryScope @default(BRANCH_CASH)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  isActive  Boolean       @default(true) @map("is_active")

  // Relations
  branch           Branch?
  purchases        Purchase[]
  sales            Sale[]
  expenses         Expense[]
  transfersOut     CashTransfer[]    @relation("TransfersFrom")
  transfersIn      CashTransfer[]    @relation("TransfersTo")
  supplierPayments SupplierPayment[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]
  payrolls         Payroll[]

  bulkPayments BulkPayment[] @relation("BulkPaymentTreasury")
  bulkRefunds  BulkRefund[]  @relation("BulkRefundTreasury")

  // Config Relations
  systemConfigAsMain     SystemConfiguration[] @relation("ConfigMainTreasury")
  systemConfigAsVisa     SystemConfiguration[] @relation("ConfigVisaTreasury")
  systemConfigAsInstapay SystemConfiguration[] @relation("ConfigInstapayTreasury")

  @@map("treasuries")
}

enum TreasuryScope {
  BRANCH_CASH
  GLOBAL_VISA
  GLOBAL_INSTAPAY
  MAIN
}

// ============================================
// Branch Management
// ============================================

model Branch {
  id          Int      @id @default(autoincrement())
  name        String
  address     String
  warehouseId Int      @unique @map("warehouse_id")
  treasuryId  Int      @unique @map("treasury_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  isActive    Boolean  @default(true) @map("is_active")

  // Relations
  warehouse       Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  treasury        Treasury       @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  employees       Employee[]
  employeeTransactions EmployeeTransaction[]
  users           User[] // Main branch users (employees, branch managers)
  accessibleUsers User[]         @relation("AccessibleBranches") // Users who have access to this branch (e.g. Area Managers)
  sales           Sale[]
  shifts          Shift[]
  DeliveryMan     DeliveryMan[]
  deliveryZones   DeliveryZone[]
  auditLogs       AuditLog[]
  orders          Order[]
  notifications   Notification[]
  clientsLastBranch Client[]

  @@map("branches")
}

// ============================================
// Client Management
// ============================================

model Client {
  id            Int           @id @default(autoincrement())
  name          String
  phoneNumber   String        @map("phone_number")
  address       String?       @db.Text
  lastBranchId  Int?          @map("last_branch_id")
  lastZoneId    Int?          @map("last_zone_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  // Relations
  sales         Sale[]
  lastBranch    Branch?       @relation(fields: [lastBranchId], references: [id])
  lastZone      DeliveryZone? @relation(fields: [lastZoneId], references: [id])

  @@map("clients")
}

// ============================================
// Supplier Management
// ============================================

model Supplier {
  id          Int              @id @default(autoincrement())
  name        String
  phoneNumber String           @map("phone_number")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  items       ItemSupplier[]
  purchases   Purchase[]
  account     SupplierAccount?

  @@map("suppliers")
}

// ============================================
// Category Management
// ============================================

model ExpenseCategory {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expenses  Expense[]

  @@map("expense_categories")
}

model Category {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  showInPos Boolean        @default(true) @map("show_in_pos")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  items     ItemCategory[]
  boms      BOMCategory[]

  @@map("categories")
}

// ============================================
// Item Management
// ============================================

model Item {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  price        Decimal  @db.Decimal(10, 2)
  costPrice    Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  unit         String
  reorderPoint Int      @default(10) @map("reorder_point")
  showInPos    Boolean  @default(true) @map("show_in_pos")
  isBom        Boolean  @default(false) @map("is_bom")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  suppliers               ItemSupplier[]
  categories              ItemCategory[]
  purchaseItems           PurchaseItem[]
  purchaseReturnItems     PurchaseReturnItem[]
  saleItems               SaleItem[]
  inventory               Inventory[]
  stockTransferItems      StockTransferItem[]
  bomOutputs              BOM[]                 @relation("BOMOutput")
  bomItems                BOMItem[]
  productionOrderItems    ProductionOrderItem[]
  initialInventoryEntries InitialInventory[]
  bulkContractPrices      BulkContractPrice[]
  bulkOrderItems          BulkOrderItem[]

  @@map("items")
}

model Inventory {
  itemId      Int      @map("item_id")
  warehouseId Int      @map("warehouse_id")
  quantity    Decimal  @default(0) @db.Decimal(18, 6)
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@id([itemId, warehouseId])
  @@map("inventory")
}

model ItemSupplier {
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int      @map("item_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int      @map("supplier_id")

  @@id([itemId, supplierId])
  @@map("item_suppliers")
}

model ItemCategory {
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int      @map("item_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int      @map("category_id")

  @@id([itemId, categoryId])
  @@map("item_categories")
}

model BOMCategory {
  bom        BOM      @relation(fields: [bomId], references: [id], onDelete: Cascade)
  bomId      Int      @map("bom_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int      @map("category_id")

  @@id([bomId, categoryId])
  @@map("bom_categories")
}

// ============================================
// Purchase Management
// ============================================

enum PaymentMethod {
  CASH // نقد - pay with cash now
  CREDIT // كريدت/فيزا - pay with card now
  DEFERRED // آجل - pay later
  MIXED // متنوع - partial payment
}

enum DiscountType {
  PERCENTAGE
  VALUE
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  RETURNED
  CANCELLED
}

model Purchase {
  id                Int           @id @default(autoincrement())
  supplierId        Int           @map("supplier_id")
  treasuryId        Int           @map("treasury_id")
  warehouseId       Int           @map("warehouse_id")
  supplierInvoiceNo String?       @map("supplier_invoice_no")
  paymentMethod     PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  subtotal          Decimal       @db.Decimal(10, 2)
  discountType      DiscountType  @default(PERCENTAGE) @map("discount_type")
  discountValue     Decimal       @default(0) @map("discount_value") @db.Decimal(10, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  netTotal          Decimal       @map("net_total") @db.Decimal(10, 2)
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  remaining         Decimal       @default(0) @db.Decimal(10, 2)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relations
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  treasury         Treasury          @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items            PurchaseItem[]
  returns          PurchaseReturn[]
  expense          Expense?
  supplierPayments SupplierPayment[]

  @@map("purchases")
}

model PurchaseItem {
  purchaseId    Int     @map("purchase_id")
  itemId        Int     @map("item_id")
  quantity      Decimal @db.Decimal(10, 4)
  purchasePrice Decimal @map("purchase_price") @db.Decimal(10, 2)
  sellPrice     Decimal @map("sell_price") @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  // Relations
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([purchaseId, itemId])
  @@map("purchase_items")
}

model PurchaseReturn {
  id           Int      @id @default(autoincrement())
  purchaseId   Int      @map("purchase_id")
  returnNumber String   @unique @map("return_number")
  notes        String?  @db.VarChar(500)
  totalAmount  Decimal  @map("total_amount") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  purchase Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  items    PurchaseReturnItem[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id               Int     @id @default(autoincrement())
  purchaseReturnId Int     @map("purchase_return_id")
  itemId           Int     @map("item_id")
  quantity         Decimal @db.Decimal(10, 4)
  purchasePrice    Decimal @map("purchase_price") @db.Decimal(10, 2)
  total            Decimal @db.Decimal(10, 2)

  purchaseReturn PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("purchase_return_items")
}

// ============================================
// POS (Point of Sale) Management
// ============================================

model Shift {
  id                 Int         @id @default(autoincrement())
  userId             Int         @map("user_id")
  branchId           Int         @map("branch_id")
  type               ShiftType   @default(MORNING)
  startTime          DateTime    @default(now()) @map("start_time")
  endTime            DateTime?   @map("end_time")
  startCash          Decimal     @default(0) @map("start_cash") @db.Decimal(10, 2)
  endCash            Decimal?    @map("end_cash") @db.Decimal(10, 2)
  systemExpectedCash Decimal?    @map("system_expected_cash") @db.Decimal(10, 2)
  actualCash         Decimal?    @map("actual_cash") @db.Decimal(10, 2)
  shortage           Decimal?    @db.Decimal(10, 2)
  expectedVisa       Decimal?    @map("expected_visa") @db.Decimal(10, 2)
  expectedInstapay   Decimal?    @map("expected_instapay") @db.Decimal(10, 2)
  status             ShiftStatus @default(OPEN)
  reviewedById       Int?        @map("reviewed_by_id")
  reviewedAt         DateTime?   @map("reviewed_at")

  // Relations
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation("ShiftReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  sales      Sale[]
  expenses   Expense[]
  employeeTransactions EmployeeTransaction[]
  payrolls   Payroll[]

  @@map("shifts")
}

enum ShiftType {
  MORNING
  EVENING
}

enum ShiftStatus {
  OPEN
  PENDING_REVIEW
  CLOSED
}

enum SalePaymentMethod {
  CASH
  INSTAPAY
  VISA
}

enum SaleStatus {
  COMPLETED
  HELD
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELED
}

model Sale {
  id                      Int               @id @default(autoincrement())
  saleNumber              String            @unique @map("sale_number")
  clientId                Int               @map("client_id")
  employeeId              Int?              @map("employee_id")
  userId                  Int?              @map("user_id")
  branchId                Int               @map("branch_id")
  treasuryId              Int               @map("treasury_id")
  warehouseId             Int?              @map("warehouse_id")
  shiftId                 Int?              @map("shift_id")
  deliveryManId           Int?              @map("delivery_man_id")
  deliveryZoneId          Int?              @map("delivery_zone_id")
  deliveryFee             Decimal?          @map("delivery_fee") @db.Decimal(10, 2)
  deliveryDriverShare     Decimal?          @map("delivery_driver_share") @db.Decimal(10, 2)
  deliveryAddress         String?           @map("delivery_address") @db.Text
  deliveryStatus          DeliveryStatus?   @map("delivery_status")
  subtotal                Decimal           @db.Decimal(10, 2)
  discountType            DiscountType?     @map("discount_type")
  discountValue           Decimal?          @map("discount_value") @db.Decimal(10, 2)
  discountAmount          Decimal?          @map("discount_amount") @db.Decimal(10, 2)
  discountReason          String?           @map("discount_reason") @db.VarChar(32)
  isVoided                Boolean           @default(false) @map("is_voided")
  discountAppliedByUserId Int?              @map("discount_applied_by_user_id")
  taxRate                 Decimal           @default(0.14) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount               Decimal           @map("tax_amount") @db.Decimal(10, 2)
  total                   Decimal           @db.Decimal(10, 2)
  paymentMethod           SalePaymentMethod @default(CASH) @map("payment_method")
  paidAmount              Decimal           @map("paid_amount") @db.Decimal(10, 2)
  changeAmount            Decimal           @default(0) @map("change_amount") @db.Decimal(10, 2)
  status                  SaleStatus        @default(COMPLETED)
  notes                   String?           @db.Text
  paidAt                  DateTime?         @map("paid_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  // Relations
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  employee          Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user              User?         @relation("SaleCreator", fields: [userId], references: [id], onDelete: Restrict)
  discountAppliedBy   User?           @relation("SaleDiscountApplier", fields: [discountAppliedByUserId], references: [id], onDelete: SetNull)
  discountReasonRef   DiscountReason? @relation(fields: [discountReason], references: [code])
  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  treasury          Treasury      @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  warehouse         Warehouse?    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  shift             Shift?        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  deliveryMan       DeliveryMan?  @relation(fields: [deliveryManId], references: [id], onDelete: SetNull)
  deliveryZone      DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items             SaleItem[]
  order             Order?

  @@map("sales")
}

model DiscountReason {
  code            String   @id @db.VarChar(32)
  labelAr         String   @map("label_ar") @db.VarChar(128)
  customerLabelAr String   @map("customer_label_ar") @db.VarChar(128)
  isActive        Boolean  @default(true) @map("is_active")
  sales           Sale[]

  @@map("discount_reasons")
}

model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  itemId    Int?    @map("item_id")
  bomId     Int?    @map("bom_id")
  quantity  Decimal @db.Decimal(10, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  // COGS snapshot: the item's cost-per-unit at the moment of sale, so profit
  // reporting subtracts the historical cost rather than the current one.
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(10, 2)

  // Relations
  sale Sale  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  bom  BOM?  @relation(fields: [bomId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

// ============================================
// Financial Transactions
// ============================================

model CashTransfer {
  id             Int            @id @default(autoincrement())
  amount         Decimal        @db.Decimal(10, 2)
  notes          String?        @db.Text
  fromTreasuryId Int            @map("from_treasury_id")
  toTreasuryId   Int            @map("to_treasury_id")
  status         TransferStatus @default(PENDING)
  createdAt      DateTime       @default(now()) @map("created_at")

  // Relations
  fromTreasury Treasury @relation("TransfersFrom", fields: [fromTreasuryId], references: [id], onDelete: Restrict)
  toTreasury   Treasury @relation("TransfersTo", fields: [toTreasuryId], references: [id], onDelete: Restrict)
  createdBy    User     @relation("TransferCreator", fields: [createdById], references: [id])
  createdById  Int      @map("created_by_id")
  acceptedBy   User?    @relation("TransferAccepter", fields: [acceptedById], references: [id])
  acceptedById Int?     @map("accepted_by_id")

  @@map("cash_transfers")
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// System Configuration
// ============================================

model SystemConfiguration {
  id          Int    @id @default(1)
  companyName String @default("ERP System") @map("company_name")
  taxNumber   String @default("") @map("tax_number")

  // Operational Defaults
  mainWarehouseId    Int? @map("main_warehouse_id")
  mainTreasuryId     Int? @map("main_treasury_id")
  visaTreasuryId     Int? @map("visa_treasury_id")
  instapayTreasuryId Int? @map("instapay_treasury_id")

  // Financial Defaults
  taxRate Decimal @default(14.0) @map("tax_rate") @db.Decimal(5, 2)

  // HR Defaults
  salaryStartDay Int    @default(1) @map("salary_start_day")
  salaryEndDay   Int    @default(30) @map("salary_end_day")
  shiftStartTime String @default("09:00") @map("shift_start_time")
  shiftEndTime   String @default("17:00") @map("shift_end_time")

  // Shift Time Configuration
  morningShiftStart String @default("09:00") @map("morning_shift_start")
  morningShiftEnd   String @default("17:00") @map("morning_shift_end")
  eveningShiftStart String @default("17:00") @map("evening_shift_start")
  eveningShiftEnd   String @default("01:00") @map("evening_shift_end")

  // POS Feature Toggles
  enablePOSDelivery Boolean @default(true) @map("enable_pos_delivery")

  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  mainWarehouse    Warehouse? @relation(fields: [mainWarehouseId], references: [id])
  mainTreasury     Treasury?  @relation("ConfigMainTreasury", fields: [mainTreasuryId], references: [id])
  visaTreasury     Treasury?  @relation("ConfigVisaTreasury", fields: [visaTreasuryId], references: [id])
  instapayTreasury Treasury?  @relation("ConfigInstapayTreasury", fields: [instapayTreasuryId], references: [id])

  @@map("system_configuration")
}

// ============================================
// Stock Transfers
// ============================================

model StockTransfer {
  id              Int                 @id @default(autoincrement())
  transferNumber  String              @unique @map("transfer_number")
  fromWarehouseId Int                 @map("from_warehouse_id")
  toWarehouseId   Int                 @map("to_warehouse_id")
  userId          Int                 @map("user_id")
  acceptedById    Int?                @map("accepted_by_id")
  status          StockTransferStatus @default(PENDING)
  notes           String?             @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  fromWarehouse Warehouse           @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse   Warehouse           @relation("StockTransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  acceptedBy    User?               @relation("StockTransferAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  items         StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id              Int     @id @default(autoincrement())
  stockTransferId Int     @map("stock_transfer_id")
  itemId          Int     @map("item_id")
  quantity        Decimal @db.Decimal(10, 4)

  // Relations
  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("stock_transfer_items")
}

enum StockTransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ============================================
// Supplier Account Management
// ============================================

model SupplierAccount {
  id         Int      @id @default(autoincrement())
  supplierId Int      @unique @map("supplier_id")
  balance    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  supplier Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  payments SupplierPayment[]

  @@map("supplier_accounts")
}

model SupplierPayment {
  id                Int      @id @default(autoincrement())
  supplierAccountId Int      @map("supplier_account_id")
  purchaseId        Int?     @map("purchase_id")
  amount            Decimal  @db.Decimal(10, 2)
  treasuryId        Int      @map("treasury_id")
  notes             String?  @db.Text
  paymentDate       DateTime @default(now()) @map("payment_date")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  supplierAccount SupplierAccount @relation(fields: [supplierAccountId], references: [id], onDelete: Restrict)
  purchase        Purchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  treasury        Treasury        @relation(fields: [treasuryId], references: [id], onDelete: Restrict)

  @@map("supplier_payments")
}

// ============================================
// Expense Management
// ============================================

enum ExpenseType {
  MANUAL
  PURCHASE
}

enum ExpensePaymentMethod {
  CASH
  CARD
}

model Expense {
  id            Int                  @id @default(autoincrement())
  description   String
  amount        Decimal              @db.Decimal(10, 2)
  date          DateTime             @db.Date
  type          ExpenseType          @default(MANUAL)
  treasuryId    Int                  @map("treasury_id")
  purchaseId    Int?                 @unique @map("purchase_id")
  shiftId       Int?                 @map("shift_id")
  categoryId    Int?                 @map("category_id")
  paymentMethod ExpensePaymentMethod @default(CASH) @map("payment_method")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  // Relations
  treasury Treasury         @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  purchase Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  shift    Shift?           @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

// ============================================
// Deposit Management
// ============================================

model Deposit {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  date        DateTime @default(now()) @db.DateTime(0)
  treasuryId  Int      @map("treasury_id")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  treasury  Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  createdBy User     @relation("DepositCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("deposits")
}

// ============================================
// Withdrawal Management
// ============================================

model Withdrawal {
  id          Int      @id @default(autoincrement())
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  date        DateTime @default(now()) @db.DateTime(0)
  treasuryId  Int      @map("treasury_id")
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  treasury  Treasury @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  createdBy User     @relation("WithdrawalCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@map("withdrawals")
}

// ============================================
// Delivery Management
// ============================================

model DeliveryMan {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String
  nationalId    String?  @map("national_id")
  vehicleType   String?  @map("vehicle_type") // motorcycle, car, van, etc.
  branchId      Int      @map("branch_id")
  walletBalance Decimal  @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  branch       Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales        Sale[]
  transactions DeliveryManTransaction[]

  @@map("delivery_men")
}

model DeliveryManTransaction {
  id            Int      @id @default(autoincrement())
  deliveryManId Int      @map("delivery_man_id")
  amount        Decimal  @db.Decimal(10, 2)
  type          String // "DEBT_ACCRUED" (Order), "PAYMENT" (Settlement)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  createdById   Int?     @map("created_by_id")

  // Relations
  deliveryMan DeliveryMan @relation(fields: [deliveryManId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("delivery_man_transactions")
}

model DeliveryZone {
  id          Int      @id @default(autoincrement())
  name        String
  fee         Decimal  @db.Decimal(10, 2)
  driverShare Decimal  @default(0) @map("driver_share") @db.Decimal(10, 2)
  branchId    Int?     @map("branch_id")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  branch            Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales             Sale[]
  clientsLastZone   Client[]

  @@unique([branchId, name])
  @@map("delivery_zones")
}

// ============================================
// Production & BOM Management
// ============================================

model BOM {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  outputItemId   Int?     @map("output_item_id")
  outputQuantity Decimal  @default(1) @map("output_quantity") @db.Decimal(10, 4)
  price          Decimal  @default(0) @db.Decimal(10, 2)
  unit           String   @default("piece")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  outputItem       Item?             @relation("BOMOutput", fields: [outputItemId], references: [id], onDelete: Restrict)
  items            BOMItem[]
  saleItems        SaleItem[]
  categories       BOMCategory[]
  productionOrders ProductionOrder[]

  @@map("bom")
}

model BOMItem {
  id       Int     @id @default(autoincrement())
  bomId    Int     @map("bom_id")
  itemId   Int     @map("item_id")
  quantity Decimal @db.Decimal(10, 4)
  notes    String? @db.Text

  // Relations
  bom  BOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([bomId, itemId])
  @@map("bom_items")
}

// ============================================
// Production Orders
// ============================================

model ProductionOrder {
  id                Int       @id @default(autoincrement())
  bomId             Int       @map("bom_id")
  sourceWarehouseId Int       @map("source_warehouse_id")
  destWarehouseId   Int?      @map("dest_warehouse_id")
  targetOutputQty   Decimal   @map("target_output_qty") @db.Decimal(10, 4)
  actualOutputQty   Decimal   @map("actual_output_qty") @db.Decimal(10, 4)
  outputWasteQty    Decimal   @default(0) @map("output_waste_qty") @db.Decimal(10, 4)
  totalCost         Decimal   @default(0) @map("total_cost") @db.Decimal(10, 2)
  notes             String?   @db.Text
  status            String    @default("COMPLETED") @db.VarChar(20)
  cancelledById     Int?      @map("cancelled_by_id")
  cancelledAt       DateTime? @map("cancelled_at")
  linkedOrderId     Int?      @map("linked_order_id")
  createdById       Int       @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  bom             BOM                   @relation(fields: [bomId], references: [id], onDelete: Restrict)
  sourceWarehouse Warehouse             @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destWarehouse   Warehouse?            @relation("DestWarehouse", fields: [destWarehouseId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("ProductionOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy     User?                 @relation("ProductionOrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  linkedOrder     ProductionOrder?      @relation("LinkedOrders", fields: [linkedOrderId], references: [id], onDelete: SetNull)
  linkedFrom      ProductionOrder[]     @relation("LinkedOrders")
  items           ProductionOrderItem[]

  @@map("production_orders")
}

model ProductionOrderItem {
  id                Int     @id @default(autoincrement())
  productionOrderId Int     @map("production_order_id")
  itemId            Int     @map("item_id")
  quantityUsed      Decimal @map("quantity_used") @db.Decimal(18, 6)

  // Relations
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("production_order_items")
}

// ============================================
// Initial / Opening Inventory
// ============================================

model InitialInventory {
  id          Int      @id @default(autoincrement())
  itemId      Int      @map("item_id")
  warehouseId Int      @map("warehouse_id")
  quantity    Decimal  @db.Decimal(18, 6)
  // Purchase cost per unit for this opening-stock entry — values the stock and
  // seeds Item.costPrice. Nullable so pre-existing rows stay valid.
  unitCost    Decimal? @map("unit_cost") @db.Decimal(10, 2)
  date        DateTime @default(now())
  notes       String?  @db.Text
  userId      Int      @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("initial_inventory")
}

// ============================================
// Orders (workflow layer) & Notifications
// ============================================

enum OrderChannel {
  POS
  CALL_CENTER
  WHATSAPP
  WEB
  AGGREGATOR
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderCancellationReason {
  CUSTOMER_REQUEST
  OUT_OF_STOCK
  WRONG_ADDRESS
  NO_ANSWER
  DUPLICATE
  OTHER
}

model Order {
  id                 Int                      @id @default(autoincrement())
  saleId             Int                      @unique @map("sale_id")
  channel            OrderChannel             @default(POS)
  status             OrderStatus              @default(NEW)
  branchId           Int                      @map("branch_id")
  createdById        Int                      @map("created_by_id")
  claimedById        Int?                     @map("claimed_by_id")
  claimedAt          DateTime?                @map("claimed_at")
  readyAt            DateTime?                @map("ready_at")
  dispatchedAt       DateTime?                @map("dispatched_at")
  deliveredAt        DateTime?                @map("delivered_at")
  cancelledAt        DateTime?                @map("cancelled_at")
  cancelReason       String?                  @map("cancel_reason") @db.Text
  cancellationReason OrderCancellationReason? @map("cancellation_reason")
  cancellationNote   String?                  @map("cancellation_note") @db.Text
  cancelledById      Int?                     @map("cancelled_by_id")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  sale        Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)
  branch      Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  claimedBy   User?  @relation("OrderClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  cancelledBy User?  @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([channel, status, branchId])
  @@index([createdById, createdAt])
  @@map("orders")
}

enum NotificationType {
  NEW_CALL_CENTER_ORDER
  ORDER_STATUS_CHANGED
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  branchId  Int?             @map("branch_id")
  type      NotificationType
  payload   Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// Bulk POS (B2B Wholesale) Module
// ============================================

enum BulkOrderStatus {
  DRAFT
  QUOTED
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
  RETURNED
}

enum BulkDocumentType {
  PROFORMA
  TAX_INVOICE
  SALES_RECEIPT
  CREDIT_NOTE
}

enum BulkPaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CREDIT
}

enum BulkRefundMethod {
  CASH_REFUND
  CREDIT_NOTE
}

model BulkCustomer {
  id                  Int      @id @default(autoincrement())
  companyName         String   @map("company_name") @db.VarChar(200)
  tradeName           String?  @map("trade_name") @db.VarChar(200)
  taxNumber           String?  @unique @map("tax_number") @db.VarChar(50)
  primaryContactName  String   @map("primary_contact_name") @db.VarChar(120)
  primaryContactPhone String   @map("primary_contact_phone") @db.VarChar(40)
  primaryContactEmail String?  @map("primary_contact_email") @db.VarChar(120)
  shippingAddress     String   @map("shipping_address") @db.Text
  creditLimit         Decimal? @map("credit_limit") @db.Decimal(12, 2)
  notes               String?  @db.Text
  isActive            Boolean  @default(true) @map("is_active")
  createdByUserId     Int?     @map("created_by_user_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  createdBy      User?                 @relation("BulkCustomerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  contacts       BulkCustomerContact[]
  contractPrices BulkContractPrice[]
  orders         BulkOrder[]
  payments       BulkPayment[]

  @@index([companyName])
  @@index([primaryContactPhone])
  @@map("bulk_customers")
}

model BulkCustomerContact {
  id         Int     @id @default(autoincrement())
  customerId Int     @map("customer_id")
  name       String  @db.VarChar(120)
  phone      String  @db.VarChar(40)
  email      String? @db.VarChar(120)
  role       String? @db.VarChar(60)

  customer BulkCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("bulk_customer_contacts")
}

model BulkContractPrice {
  id              Int      @id @default(autoincrement())
  customerId      Int      @map("customer_id")
  itemId          Int      @map("item_id")
  price           Decimal  @db.Decimal(10, 2)
  createdByUserId Int?     @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  customer  BulkCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  item      Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("BulkContractPriceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([customerId, itemId])
  @@index([itemId])
  @@map("bulk_contract_prices")
}

model BulkOrder {
  id              Int             @id @default(autoincrement())
  orderNumber     String?         @unique @map("order_number")
  customerId      Int             @map("customer_id")
  warehouseId     Int             @map("warehouse_id")
  createdByUserId Int             @map("created_by_user_id")
  status          BulkOrderStatus @default(DRAFT)

  subtotalInclusive Decimal @map("subtotal_inclusive") @db.Decimal(12, 2)
  taxRate           Decimal @default(0.14) @map("tax_rate") @db.Decimal(5, 4)
  netAmount         Decimal @map("net_amount") @db.Decimal(12, 2)
  taxAmount         Decimal @map("tax_amount") @db.Decimal(12, 2)
  total             Decimal @db.Decimal(12, 2)

  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(12, 2)
  balanceDue Decimal @map("balance_due") @db.Decimal(12, 2)

  scheduledPickupDate DateTime? @map("scheduled_pickup_date")
  confirmedAt         DateTime? @map("confirmed_at")
  paidAt              DateTime? @map("paid_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelledByUserId   Int?      @map("cancelled_by_user_id")
  cancelReason        String?   @map("cancel_reason") @db.Text
  returnedAt          DateTime? @map("returned_at")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer    BulkCustomer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("BulkOrderCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy User?           @relation("BulkOrderCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  items       BulkOrderItem[]
  documents   BulkDocument[]
  payments    BulkPayment[]
  refunds     BulkRefund[]

  @@index([customerId, status])
  @@index([status, createdAt])
  @@map("bulk_orders")
}

model BulkOrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  itemId    Int     @map("item_id")
  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(12, 2)

  order BulkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("bulk_order_items")
}

model BulkDocument {
  id             Int              @id @default(autoincrement())
  orderId        Int              @map("order_id")
  type           BulkDocumentType
  documentNumber String           @unique @map("document_number")
  issuedAt       DateTime         @default(now()) @map("issued_at")
  issuedByUserId Int              @map("issued_by_user_id")
  snapshot       Json?

  order BulkOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, type])
  @@map("bulk_documents")
}

model BulkNumberSequence {
  key       String   @id
  nextValue Int      @default(1) @map("next_value")
  prefix    String   @db.VarChar(20)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bulk_number_sequences")
}

model BulkPayment {
  id              Int               @id @default(autoincrement())
  orderId         Int?              @map("order_id")
  customerId      Int               @map("customer_id")
  treasuryId      Int?              @map("treasury_id")
  method          BulkPaymentMethod
  amount          Decimal           @db.Decimal(12, 2)
  receivedAt      DateTime          @default(now()) @map("received_at")
  createdByUserId Int               @map("created_by_user_id")

  bankReference String?   @map("bank_reference") @db.VarChar(120)
  chequeNumber  String?   @map("cheque_number") @db.VarChar(60)
  chequeDueDate DateTime? @map("cheque_due_date")

  voidedAt       DateTime? @map("voided_at")
  voidedByUserId Int?      @map("voided_by_user_id")
  voidReason     String?   @map("void_reason") @db.Text

  notes String? @db.Text

  order     BulkOrder?   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer  BulkCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  treasury  Treasury?    @relation("BulkPaymentTreasury", fields: [treasuryId], references: [id], onDelete: Restrict)
  createdBy User         @relation("BulkPaymentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  voidedBy  User?        @relation("BulkPaymentVoider", fields: [voidedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId, receivedAt])
  @@map("bulk_payments")
}

model BulkRefund {
  id               Int              @id @default(autoincrement())
  orderId          Int              @map("order_id")
  method           BulkRefundMethod
  amount           Decimal          @db.Decimal(12, 2)
  reason           String?          @db.Text
  treasuryId       Int?             @map("treasury_id")
  creditNoteNumber String?          @unique @map("credit_note_number")
  createdByUserId  Int              @map("created_by_user_id")
  createdAt        DateTime         @default(now()) @map("created_at")

  order     BulkOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  treasury  Treasury? @relation("BulkRefundTreasury", fields: [treasuryId], references: [id], onDelete: Restrict)
  createdBy User      @relation("BulkRefundCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("bulk_refunds")
}
