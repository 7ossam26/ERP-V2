# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================

# 1. Server Configuration
# -----------------------
# Hostinger assigns a port automatically via process.env.PORT.
# However, you can leave this as a fallback.
PORT=3000
NODE_ENV=production

# 2. Database Configuration (Hostinger MySQL)
# -----------------------
# Gather these details from Hostinger Dashboard -> Databases
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example: mysql://u123456789_admin:StrongPass123!@mysql.hostinger.com:3306/u123456789_erp_db
DATABASE_URL="mysql://root:@127.0.0.1:3306/erp_system"

# 3. Security (CRITICAL)
# -----------------------
# You MUST change this. Run this in your terminal to generate a strong key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=b0a5f54f9695ce89255622f0a15c5518dab3a6037bc4fb75884d5cb962a25741
JWT_EXPIRES_IN=7d

# 4. Frontend URL (CORS)
# -----------------------
# In Production (Single Node), this is usually your own domain or localhost if serving statically.
# Add your actual domain(s) here.
FRONTEND_URL=https://elrahma.kiko-tech.com,https://test.kiko-tech.com,http://www.test.kiko-tech.com,http://localhost:5173

# 5. Optional Features
# -----------------------
# If you have email services, etc., add them here.
