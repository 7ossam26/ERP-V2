generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// Auth & Access Control
// ============================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  roleId    Int      @map("role_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  users       User[]
  permissions Permission[]

  @@map("roles")
}

enum Module {
  HR
  INVENTORY
  POS
  PURCHASES
  SALES
  REPORTS
  TREASURIES
  BRANCHES
  EMPLOYEES
  CLIENTS
  SUPPLIERS
  CATEGORIES
  ITEMS
  WAREHOUSES
  SETTINGS
}

model Permission {
  id        Int     @id @default(autoincrement())
  roleId    Int     @map("role_id")
  module    Module
  canView   Boolean @default(false) @map("can_view")
  canCreate Boolean @default(false) @map("can_create")
  canEdit   Boolean @default(false) @map("can_edit")
  canDelete Boolean @default(false) @map("can_delete")

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("permissions")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  details      Json?
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// ============================================
// Employee Management
// ============================================

model Employee {
  id               Int       @id @default(autoincrement())
  name             String
  position         String
  branchId         Int       @map("branch_id")
  phoneNumber      String    @map("phone_number")
  nationalId       String?   @map("national_id")
  workingDaysPerMonth Int    @default(26) @map("working_days_per_month")
  workingHoursPerDay  Decimal @default(8) @db.Decimal(4, 2) @map("working_hours_per_day")
  weeklyHoliday    String    @default("Friday") @map("weekly_holiday")
  salary           Decimal   @db.Decimal(10, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  
  // Relations
  branch           Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sales            Sale[]

  @@map("employees")
}

// ============================================
// Warehouse Management
// ============================================

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  branch    Branch?
  purchases Purchase[]
  sales     Sale[]
  
  // Config Relations
  systemConfigAsMain  SystemConfiguration[] 

  @@map("warehouses")
}

// ============================================
// Treasury Management
// ============================================

model Treasury {
  id        Int      @id @default(autoincrement())
  name      String
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  // Relations
  branch    Branch?
  purchases Purchase[]
  sales     Sale[]
  transfersOut CashTransfer[] @relation("TransfersFrom")
  transfersIn  CashTransfer[] @relation("TransfersTo")
  
  // Config Relations
  systemConfigAsMain SystemConfiguration[] @relation("ConfigMainTreasury")
  systemConfigAsBank SystemConfiguration[] @relation("ConfigBankTreasury")

  @@map("treasuries")
}

// ============================================
// Branch Management
// ============================================

model Branch {
  id          Int       @id @default(autoincrement())
  name        String
  address     String
  warehouseId Int       @unique @map("warehouse_id")
  treasuryId  Int       @unique @map("treasury_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  treasury    Treasury  @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  employees   Employee[]
  sales       Sale[]

  @@map("branches")
}

// ============================================
// Client Management
// ============================================

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  sales       Sale[]

  @@map("clients")
}

// ============================================
// Supplier Management
// ============================================

model Supplier {
  id          Int      @id @default(autoincrement())
  name        String
  phoneNumber String   @map("phone_number")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("suppliers")
  items     ItemSupplier[]
  purchases Purchase[]
}

// ============================================
// Category Management
// ============================================

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
  items     ItemCategory[]
}

// ============================================
// Item Management
// ============================================

model Item {
  id        Int        @id @default(autoincrement())
  name      String
  price     Decimal    @db.Decimal(10, 2)
  unit      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  // Relations
  suppliers     ItemSupplier[]
  categories    ItemCategory[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@map("items")
}

model ItemSupplier {
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int      @map("item_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int      @map("supplier_id")

  @@id([itemId, supplierId])
  @@map("item_suppliers")
}

model ItemCategory {
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     Int      @map("item_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int      @map("category_id")

  @@id([itemId, categoryId])
  @@map("item_categories")
}

// ============================================
// Purchase Management
// ============================================

enum PaymentMethod {
  CASH
  CREDIT
  MIXED
}

enum DiscountType {
  PERCENTAGE
  VALUE
}

model Purchase {
  id                Int            @id @default(autoincrement())
  supplierId        Int            @map("supplier_id")
  treasuryId        Int            @map("treasury_id")
  warehouseId       Int            @map("warehouse_id")
  supplierInvoiceNo String?        @map("supplier_invoice_no")
  paymentMethod     PaymentMethod  @default(CASH) @map("payment_method")
  subtotal          Decimal        @db.Decimal(10, 2)
  discountType      DiscountType   @default(PERCENTAGE) @map("discount_type")
  discountValue     Decimal        @default(0) @db.Decimal(10, 2) @map("discount_value")
  discountAmount    Decimal        @default(0) @db.Decimal(10, 2) @map("discount_amount")
  netTotal          Decimal        @db.Decimal(10, 2) @map("net_total")
  paidAmount        Decimal        @default(0) @db.Decimal(10, 2) @map("paid_amount")
  remaining         Decimal        @default(0) @db.Decimal(10, 2)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  supplier          Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  treasury          Treasury       @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items             PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  purchaseId    Int      @map("purchase_id")
  itemId        Int      @map("item_id")
  quantity      Decimal  @db.Decimal(10, 2)
  purchasePrice Decimal  @db.Decimal(10, 2) @map("purchase_price")
  sellPrice     Decimal  @db.Decimal(10, 2) @map("sell_price")
  total         Decimal  @db.Decimal(10, 2)

  // Relations
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@id([purchaseId, itemId])
  @@map("purchase_items")
}

// ============================================
// POS (Point of Sale) Management
// ============================================

enum SalePaymentMethod {
  CASH
  CARD
}

enum SaleStatus {
  COMPLETED
  HELD
  CANCELLED
}

model Sale {
  id             Int                @id @default(autoincrement())
  saleNumber     String             @unique @map("sale_number")
  clientId       Int                @map("client_id")
  employeeId     Int                @map("employee_id")
  branchId       Int                @map("branch_id")
  treasuryId     Int                @map("treasury_id")
  warehouseId    Int?               @map("warehouse_id")
  subtotal       Decimal            @db.Decimal(10, 2)
  taxRate        Decimal            @default(0.14) @db.Decimal(5, 4) @map("tax_rate")
  taxAmount      Decimal            @db.Decimal(10, 2) @map("tax_amount")
  total          Decimal            @db.Decimal(10, 2)
  paymentMethod  SalePaymentMethod  @default(CASH) @map("payment_method")
  paidAmount     Decimal            @db.Decimal(10, 2) @map("paid_amount")
  changeAmount   Decimal            @default(0) @db.Decimal(10, 2) @map("change_amount")
  status         SaleStatus         @default(COMPLETED)
  notes          String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  // Relations
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  treasury       Treasury           @relation(fields: [treasuryId], references: [id], onDelete: Restrict)
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items          SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        Int      @id @default(autoincrement())
  saleId    Int      @map("sale_id")
  itemId    Int      @map("item_id")
  quantity  Decimal  @db.Decimal(10, 2)
  unitPrice Decimal  @db.Decimal(10, 2) @map("unit_price")
  total     Decimal  @db.Decimal(10, 2)

  // Relations
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

// ============================================
// Financial Transactions
// ============================================

model CashTransfer {
  id            Int      @id @default(autoincrement())
  amount        Decimal  @db.Decimal(10, 2)
  notes         String?  @db.Text
  fromTreasuryId Int     @map("from_treasury_id")
  toTreasuryId   Int     @map("to_treasury_id")
  status        TransferStatus @default(PENDING)
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  fromTreasury  Treasury @relation("TransfersFrom", fields: [fromTreasuryId], references: [id], onDelete: Restrict)
  toTreasury    Treasury @relation("TransfersTo", fields: [toTreasuryId], references: [id], onDelete: Restrict)

  @@map("cash_transfers")
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// System Configuration
// ============================================

model SystemConfiguration {
  id              Int      @id @default(1)
  companyName     String   @default("ERP System") @map("company_name")
  
  // Operational Defaults
  mainWarehouseId Int?     @map("main_warehouse_id")
  mainTreasuryId  Int?     @map("main_treasury_id")
  bankTreasuryId  Int?     @map("bank_treasury_id")
  
  // Financial Defaults
  taxRate         Decimal  @default(14.0) @db.Decimal(5, 2) @map("tax_rate")
  
  // HR Defaults
  salaryStartDay  Int      @default(1) @map("salary_start_day")
  salaryEndDay    Int      @default(30) @map("salary_end_day")
  shiftStartTime  String   @default("09:00") @map("shift_start_time")
  shiftEndTime    String   @default("17:00") @map("shift_end_time")
  
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Relations
  mainWarehouse   Warehouse? @relation(fields: [mainWarehouseId], references: [id])
  mainTreasury    Treasury?  @relation("ConfigMainTreasury", fields: [mainTreasuryId], references: [id])
  bankTreasury    Treasury?  @relation("ConfigBankTreasury", fields: [bankTreasuryId], references: [id])

  @@map("system_configuration")
}
