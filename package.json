{
  "name": "erp-v2-desktop",
  "version": "1.1.0",
  "description": "ERP Desktop Application",
  "main": "main.js",
  "author": "KikoTech",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently --kill-others \"npm run dev:electron\" \"wait-on http://127.0.0.1:3001/api/health && npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build:frontend": "cd frontend && npm install --include=dev && npm run build",
    "build:prisma": "cd backend && npx prisma generate",
    "predist": "npm run build:frontend && npm run build:prisma",
    "dist": "electron-builder",
    "postinstall": "cd backend && npm install && npx prisma generate"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.0.3",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "nodemon": "^3.1.11",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.kikotech.erp",
    "productName": "ERP System",
    "copyright": "Copyright © 2026 KikoTech",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.prisma/**",
          "!node_modules/@prisma/engines/**",
          "!node_modules/prisma/query-engine*",
          "!node_modules/prisma/query_engine*",
          "!prisma/migrations/**",
          "!.env",
          "!.env.local",
          "!tests/**",
          "!dev.db",
          "!dev.db-journal",
          "!dev.db-wal",
          "!deployment.log"
        ]
      },
      {
        "from": "backend/client_dist",
        "to": "client_dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "uninstallDisplayName": "ERP System",
      "artifactName": "ERP-System-Setup-${version}.${ext}"
    }
  }
}